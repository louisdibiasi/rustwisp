# rustwisp Wisp server, hardened for an untrusted network-facing service.
#
# Threat model: the process parses attacker-controlled bytes and opens outbound sockets to
# attacker-chosen hosts, so a remote-code-execution or memory-corruption bug in it must not become
# a foothold on the host. The unit runs as the dedicated unprivileged `wisp` user (no shell, no
# login, home is the state dir) and the sandbox below strips every capability and kernel surface
# the server does not need. Each directive is load-bearing; review it before relaxing it.
[Unit]
Description=rustwisp Wisp server
Documentation=https://github.com/louisdibiasi/rustwisp
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=wisp
Group=wisp

# Config and state. /etc/rustwisp/rustwisp.conf is root:wisp 0640 (it may hold password hashes, so
# it is not world-readable). The reputation store lives under /var/lib/rustwisp.
ExecStart=/usr/bin/rustwisp --config /etc/rustwisp/rustwisp.conf

# A relay legitimately opens many sockets; raise the fd ceiling but keep it finite.
LimitNOFILE=262144
# Cap memory and tasks so a leak or a fork bomb in a compromised process cannot take the host down.
MemoryMax=1G
TasksMax=512

Restart=on-failure
RestartSec=2s

# ---- Sandbox. Everything below reduces what a compromised process can reach. ----

# No new privileges, ever: setuid/setgid binaries and file capabilities are neutered, so even if
# the process tricks itself into exec'ing one it gains nothing. This also covers the optional
# Twisp PTY feature: a shell it spawns inherits the same locked-down context.
NoNewPrivileges=yes

# Strip all capabilities. The server binds its port (>=1024 by default) before serving, so it needs
# none at runtime. To listen on a port <1024, set both AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE rather than opening the whole set.
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: the whole hierarchy is read-only, home directories are hidden, /tmp is private, and
# the only writable path is the state directory.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rustwisp

# Kernel and device surface: no raw devices, no kernel tunables/modules/logs, no cgroup writes, no
# clock changes, no ptrace of other processes, a pid-only /proc, no new namespaces, no W+X memory.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
KeyringMode=private

# Network: TCP and UDP over IPv4/IPv6 only. Denies AF_UNIX, AF_NETLINK, AF_PACKET (raw capture or
# injection) and every other socket family.
RestrictAddressFamilies=AF_INET AF_INET6

# System calls: the common service set, with the dangerous groups dropped and non-native ABIs
# refused. @system-service already includes the tty/forkpty calls the optional Twisp feature needs.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @cpu-emulation @swap @reboot @mount @debug @raw-io
SystemCallErrorNumber=EPERM

# Any file the process creates (the reputation store) is owner-only.
UMask=0077

[Install]
WantedBy=multi-user.target
