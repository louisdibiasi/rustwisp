# rustwisp configuration. Every key is also a --key command-line flag; flags win.
# Values are plain words or "quoted strings"; booleans are on/off, true/false, 1/0.
# Lines starting with # are comments. Lists are built by repeating the key.

# ---------------------------------------------------------------- listening
host =
port = 6001
workers = 0                      # 0 = one per CPU
log-level = info                 # debug | info | warn | error | none

# ---------------------------------------------------------------- what clients may reach
allow-tcp = on
allow-udp = on
allow-direct-ip = off            # literal IPs in CONNECT
allow-private = off              # RFC 1918, CGNAT, fc00::/7
allow-loopback = off
allow-link-local = off
# allow-host = example.com       # when any allow-host is set, only those (and *.suffix) pass
# block-host = *.internal.corp
# allow-port = 80
# allow-port = 443
# block-port = 25
# block-port = 6000-6100

# ---------------------------------------------------------------- protocol
enable-v2 = on
enable-twisp = off               # PTY streams; needs v2 and an authenticated client
motd =
# password-user = alice:$2b$12$...hash...   # hashes (bcrypt $2b$, SHA-256 $5$, SHA-512 $6$) or plain text
password-required = off
buffer-remaining = 128

# ---------------------------------------------------------------- who the client is
parse-real-ip = on
# trusted-proxy = 127.0.0.1
# trusted-proxy = 10.0.0.0/8
trusted-header = CF-Connecting-IP
trusted-header = X-Forwarded-For

# ---------------------------------------------------------------- per-client limits
connections-limit-per-ip = 200   # new WebSockets per IP per window (0 = off)
connection-window-s = 10
bandwidth-limit-kbps = 0         # per IP, each direction (0 = off)
max-streams-per-conn = 2048

# ---------------------------------------------------------------- flood protection
flood-protection = on
max-connects-per-source-per-second = 500
max-connects-per-dest-per-second = 100
max-connects-per-dest-per-minute = 3000
max-in-flight-syns = 4096
max-concurrent-connections = 50000
syn-signature = on
syn-signature-window-ms = 2000
syn-signature-min-samples = 128
syn-signature-failed-ratio = 0.75
ws-close-after-violations = 64
log-blocked-dials = off

# ---------------------------------------------------------------- reputation
reputation = on
reputation-store = ./data/reputation.json
reputation-save-interval-s = 30
reputation-decay-per-hour = 1
reputation-evict-after-days = 7
reputation-warn = 21
reputation-throttle = 51
reputation-strict = 81
# reputation-weight = synSignature:25          # source weights, event:points
# reputation-dest-weight = synSignature:30

# ---------------------------------------------------------------- where streams go
# Upstream proxy for every outbound TCP stream. The name is resolved and policy-checked here first,
# and the proxy is told to connect to the address that passed, so it cannot be steered elsewhere by
# a name that resolves differently on its side. socks5h:// is accepted as an alias for socks5://.
# proxy = socks5://user:pass@127.0.0.1:1080  # or http://host:3128
# Send the hostname as the client gave it instead (SOCKS5 domain, CONNECT host:port) so the proxy can
# resolve or route by name. The proxy then resolves it itself and the address checks above no longer
# bind it: only turn this on if the proxy applies its own egress rules.
# proxy-send-hostnames = off
# UDP cannot go through the proxy: refuse it (default) or relay it directly, bypassing the proxy.
# proxy-udp = refuse                         # refuse | direct
# dns-server = 1.1.1.1
# dns-server = [2606:4700:4700::1111]:53
dns-ttl-s = 120
dns-negative-ttl-s = 10
dns-order = ipv4first            # ipv4first | ipv6first | verbatim
dns-timeout-ms = 3000

# ---------------------------------------------------------------- tuning
# The advertised packet window fits in stream-queue-max (128 packets with these defaults).
# Refill credits also share ws-write-high-water between live streams. A stream that exceeds
# its queue limit closes with 0x49. The aggregate upload queue instead pauses client reads
# above conn-queue-max and resumes below half that limit; it does not close the streams.
max-message-size = 1048581
ws-write-high-water = 8388608
stream-queue-max = 134217728
conn-queue-max = 268435456       # must be at least stream-queue-max
# Accepted-client receive buffer, used only when socket-buffer-size is 0. A value of 0
# keeps receive autotuning enabled. If the kernel
# cannot grant an effective buffer of at least 4 MiB, leave receive autotuning enabled.
client-recv-buffer = 8388608
socket-buffer-size = 0           # SO_RCVBUF/SO_SNDBUF; 0 = kernel default
connect-timeout-ms = 15000
handshake-timeout-ms = 10000
resolver-threads = 4
busy-poll-us = 0                # 0 = off; spinning after activity trades CPU for latency
stop-on-stdin-eof = off         # opt in when a parent owns stdin; leave off for services
tcp-nodelay = on
tcp-quickack = on
listen-backlog = 1024
non-ws-response = "rustwisp: a Wisp server. Connect with a WebSocket client."
serve-webclient = on                # show the built-in browser client on GET /
webclient-wisp-url =                # ws(s):// URL the web client offers by default; empty = this origin
